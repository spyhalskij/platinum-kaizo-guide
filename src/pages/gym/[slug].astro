---
import Base from '../../layouts/Base.astro'; import Trainer from '../../components/Trainer.astro'; import { marked } from 'marked';
import gyms from '../../data/gyms.json'; import trainers from '../../data/trainers.json'; import areas from '../../data/areas.json';
export function getStaticPaths(){ return gyms.map(g=>({params:{slug:g.slug},props:{g}})); }
const { g } = Astro.props; const b = import.meta.env.BASE_URL;
const gymAreas = [...new Set(g.fights.map(id=>trainers[id].area))];
const gauntlet = trainers.filter(t=>gymAreas.includes(t.area) && !g.fights.includes(t.id));
---
<Base title={g.name}><h1>{g.name}</h1>
<p class="mut">Split: {g.split}. Area(s): {gymAreas.join(', ') || 'not in docs'}</p>
<h2>Curated answers</h2>
{g.answers.length ? g.answers.map(s => <div class="card md" set:html={marked.parse(s)} />) : <p class="mut">No curated gym answers for this fight in docs. Use the team below.</p>}
<h2>Leader team</h2>{g.fights.map(id => <Trainer t={trainers[id]} />)}
{gauntlet.length > 0 && <><h2>Other trainers in the same area ({gauntlet.length})</h2>{gauntlet.map(t => <Trainer t={t} />)}</>}
</Base>
