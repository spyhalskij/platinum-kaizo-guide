---
import Base from '../../layouts/Base.astro'; import Fight from '../../components/Fight.astro'; import TrainerNav from '../../components/TrainerNav.astro'; import OrderNote from '../../components/OrderNote.astro'; import PMatchups from '../../components/PMatchups.astro'; import PNote from '../../components/PNote.astro'; import SpeedNote from '../../components/SpeedNote.astro';
import fights from '../../data/fights.json'; import trainers from '../../data/trainers.json';
export function getStaticPaths(){
  const paths = fights.map(f=>({params:{slug:f.slug},props:{f,alias:false}}));
  // old per-trainer URLs of merged multi battles render the merged fight (canonical + redirect)
  for (const f of fights) if (f.kind!=='single') for (const id of f.members) if (trainers[id].slug!==f.slug) paths.push({params:{slug:trainers[id].slug},props:{f,alias:true}});
  return paths; }
const { f, alias } = Astro.props; const b = import.meta.env.BASE_URL; const canon = `${b}trainer/${f.slug}/`;
---
<Base title={f.title} canonical={canon} redirect={alias ? canon : null}><h1>{f.title}</h1>
{alias && <p class="mut">This trainer is part of a multi/double battle, shown here as one fight. <a href={canon}>Go to the fight page</a>.</p>}
<div class="card"><TrainerNav f={f} /></div><Fight f={f} link={false} />
{f.pchal && <section class="card pchal" id="pchal"><h2 style="margin-top:0">pChal matchups ({f.pchal.length})</h2><PNote extra="Opponent levels are blank in the source." /><PMatchups ids={f.pchal} /><p style="font-size:13px"><a href={`${import.meta.env.BASE_URL}pchal/matchups/`}>All opponents</a></p></section>}
<p><a href={`${b}trainers/${f.areaSlug}/`}>All trainers in {f.area}</a></p><OrderNote /><SpeedNote /></Base>
