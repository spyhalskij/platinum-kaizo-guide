---
import Base from '../../layouts/Base.astro'; import Trainer from '../../components/Trainer.astro'; import TrainerNav from '../../components/TrainerNav.astro'; import OrderNote from '../../components/OrderNote.astro'; import SpeedNote from '../../components/SpeedNote.astro'; import trainers from '../../data/trainers.json';
export function getStaticPaths(){ return trainers.map(t=>({params:{slug:t.slug},props:{t}})); }
const { t } = Astro.props;
---
<Base title={t.name}><h1>{t.name}</h1><div class="card"><TrainerNav t={t} /></div><Trainer t={t} link={false} /><p><a href={`${import.meta.env.BASE_URL}trainers/${t.areaSlug}/`}>All trainers in {t.area}</a></p><OrderNote /><SpeedNote /></Base>
