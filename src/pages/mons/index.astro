---
import Base from '../../layouts/Base.astro'; import mons from '../../data/mons.json'; const b = import.meta.env.BASE_URL;
---
<Base title="Pokémon"><h1>Pokémon ({mons.length})</h1><p class="mut">Kaizo stats/types from the personal-data sheet.</p>
<input id="f" placeholder="Filter by name or type…"><div class="wrap card"><table><thead><tr><th>#</th><th>Name</th><th>Type</th><th>BST</th><th>Locations</th></tr></thead><tbody>
{mons.map(m => <tr data-n={(m.name+' '+m.types.join(' ')).toLowerCase()}><td>{m.id}</td><td><a href={`${b}mon/${m.slug}/`}>{m.name}</a></td><td>{m.types.join(' / ')}</td><td>{m.stats.BST.replace('.0','')}</td><td>{m.locations.length || '—'}</td></tr>)}
</tbody></table></div><script is:inline>document.getElementById('f').oninput=e=>{const v=e.target.value.toLowerCase();document.querySelectorAll('tr[data-n]').forEach(r=>r.hidden=!r.dataset.n.includes(v))}</script></Base>
