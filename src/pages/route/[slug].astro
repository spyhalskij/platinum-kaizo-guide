---
import Base from '../../layouts/Base.astro'; import Trainer from '../../components/Trainer.astro';
import areas from '../../data/areas.json'; import trainers from '../../data/trainers.json'; import items from '../../data/items.json';
export function getStaticPaths(){ return areas.map(a=>({params:{slug:a.slug},props:{a}})); }
const { a } = Astro.props; const b = import.meta.env.BASE_URL;
const enc = Object.entries(a.enc);
---
<Base title={a.name}><h1>{a.name}</h1>
<h2>Wild encounters</h2>
{enc.length ? <div class="grid">{enc.map(([m,list]) => <div class="card"><h3>{m}</h3><table><thead><tr><th>Pokémon</th><th>Rate</th><th>Lv</th></tr></thead><tbody>
{list.map(e=> <tr><td>{e.slug?<a href={`${b}mon/${e.slug}/`}>{e.mon}</a>:e.mon}</td><td>{e.rate || <span class="mut">not in docs</span>}</td><td>{e.lvl}</td></tr>)}</tbody></table></div>)}</div>
: <p class="mut">No wild encounters for this area in docs.</p>}
<h2>Items here ({a.items.length})</h2>
{a.items.length ? <div class="wrap card"><table><thead><tr><th>Item</th><th>Where</th><th>Requires</th></tr></thead><tbody>{a.items.map(i=>items[i]).map(i=> <tr><td>{i.name}{i.qty && ` ×${i.qty}`}</td><td>{i.loc}</td><td>{i.req||'—'}</td></tr>)}</tbody></table></div> : <p class="mut">None in docs.</p>}
<h2>Trainers ({a.trainers.length})</h2>
{a.trainers.length ? a.trainers.map(id => <Trainer t={trainers[id]} />) : <p class="mut">None in docs.</p>}
</Base>
