---
import Base from '../../../layouts/Base.astro'; import PNote from '../../../components/PNote.astro'; import Rich from '../../../components/Rich.astro'; import PVideo from '../../../components/PVideo.astro';
import P from '../../../data/pchal.json'; import areas from '../../../data/areas.json'; const b = import.meta.env.BASE_URL;
const an = Object.fromEntries(areas.map(a=>[a.slug,a.name]));
const rows = P.routing.filter(r=>r.hold);
---
<Base title="pChal hold checklist"><h1>pChal hold checklist</h1>
<PNote extra="Every routing row with a hold/timing condition, in route order. General rules (no single route) are listed last. The routing data has no confidence column." />
<div class="wrap card pchal"><table><thead><tr><th>✓</th><th>Route</th><th>Target</th><th>Method</th><th>Hold until / why</th><th>Notes</th><th>Video</th></tr></thead><tbody>
{rows.map(r=><tr><td><input type="checkbox" style="width:auto" /></td><td>{r.areas.length ? r.areas.map((s,i)=><>{i>0 && ', '}<a href={`${b}encounters/${s}/#pchal`}>{an[s]}</a></>) : <span class="mut">{r.route}</span>}{r.areas.length>0 && <div class="mut" style="font-size:12px">source: {r.route}</div>}</td><td><Rich s={r.target} /></td><td>{r.method}</td><td><b>{r.hold}</b></td><td style="font-size:13px"><Rich s={r.notes} /></td><td><PVideo v={r.video} /></td></tr>)}
</tbody></table></div><p class="mut" style="font-size:12px">Checkboxes are for your own tracking and aren't saved.</p></Base>
