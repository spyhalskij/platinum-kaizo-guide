---
// Old /pchal/ URLs redirect to their new homes.
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){ return [[undefined,'encounters/routing-tips/'],['priority','encounters/routing-tips/#by-route'],['hold','encounters/routing-tips/#hold'],['matchups','trainers/']].map(([p,to])=>({params:{p},props:{to}})); }
const { to } = Astro.props; const u = import.meta.env.BASE_URL + to;
---
<Base title="Moved" redirect={u} canonical={u}><h1>Moved</h1><p>This page moved to <a href={u}>{u}</a>.</p></Base>
