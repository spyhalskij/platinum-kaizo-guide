---
// "Known good matchups" for one fight (pChal, partial). No video links.
import P from '../data/pchal.json'; import Rich from './Rich.astro';
const { ids = [] } = Astro.props; const b = import.meta.env.BASE_URL;
const rows = ids.map(i => P.matchups[i]);
---
{rows.length > 0 && <div class="matchups"><h4>Known good matchups <span class="mut" style="font-weight:400;font-size:12px">(pChal, partial<a href="#pnote">‡</a>)</span></h4>
<ul>{rows.map(r => <li><span class={`conf conf-${r.confidence}`}>{r.confidence === 'low' ? 'LOW confidence' : r.confidence}</span> <b>vs {r.oppLink ? <a href={`${b}mon/${r.oppLink}/`}>{r.opp}</a> : r.opp}</b>
{r.oppNote && <span class="mut"> ({r.oppNote})</span>}{r.onTeam === false && <span class="flag"> not on this team in the trainer sheet</span>}{r.sp === null && <span class="flag"> species not named in source</span>}
{r.oppMoves && <span class="mut"> · {r.oppMoves}</span>}
<div>Answer: <Rich s={r.answer} />{r.why.length > 0 && <span class="mut"> · <Rich s={r.why} /></span>}</div>
{r.avoid.length > 0 && <div class="mut">Avoid: <Rich s={r.avoid} /></div>}</li>)}</ul></div>}
