---
// Renders one trainer entry's team. `sub` = inside a fight card (no outer card).
const { t, link = true, sub = false, href = null } = Astro.props; const b = import.meta.env.BASE_URL;
const url = href || `${b}trainer/${t.slug}/`;
---
<div class={sub ? 'subteam' : 'card'}>{sub ? <h4>{t.display}</h4> : <h3>{link ? <a href={url}>{t.display}</a> : t.display} <span class="mut" style="font-weight:400;font-size:13px">· {t.area} · {t.split} split</span></h3>}
{t.note && <p class="mut">{t.note}</p>}
<div class="grid">{t.team.map(m => <div class="mon"><b>{m.slug ? <a href={`${b}mon/${m.slug}/`}>{m.label}</a> : m.label}</b>
<div class="spe" title={m.spe ? (m.spe.src==='pkcalc' ? `Actual Speed at Lv ${m.spe.lv}: Kaizo base ${m.spe.base}, IV ${m.spe.iv}, EV ${m.spe.ev} (PKCalc set: ${m.spe.pkTrainer})` : `No matching PKCalc set: IV 0–31, 0 EVs (Kaizo base ${m.spe.base})`) : ''}>{m.spe ? <>Spe <b>{m.spe.min === m.spe.max ? m.spe.min : `${m.spe.min}–${m.spe.max}`}</b> <span class="mut">({m.spe.src==='pkcalc' ? `actual, IV ${m.spe.iv}` : 'actual, IV 0–31: no PKCalc match'}{m.spe.natureKnown ? '' : ', nature?'})<a href="#speed-note">*</a></span></> : <span class="mut">Spe: species/level not in docs</span>}</div>
<div class="mut" style="font-size:13px">{[m.nature, m.ability, m.item].filter(Boolean).join(' · ') || 'not in docs'}</div>
<div style="font-size:13px">{m.moves.length ? m.moves.join(' / ') : <span class="mut">moves not in docs</span>}</div></div>)}</div><slot /></div>
