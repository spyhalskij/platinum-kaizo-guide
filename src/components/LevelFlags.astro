---
// Level cap (HoF rules, mechanics.md) + optional pChal level pacing (pchal-level-pacing.csv; renders nothing if absent).
import P from '../data/pchal.json';
const { f = null, area = null } = Astro.props;
const pace = ((f ? f.pacing : area?.pacing) || []).map(i => P.pacing[i]);
const rng = r => r.min != null && r.max != null && r.min !== r.max ? `${r.min}–${r.max}` : `${r.min ?? r.max}`;
---
{(f?.cap || pace.length > 0) && <div class="lvflags">
{f?.cap && <span class="capflag" title="Hall of Fame rules (mechanics.md): enter fights at or under the cap">{f.cap.label}: Lv {f.cap.level}</span>}
{pace.map(r => <span class="paceflag">{area ? 'Recommended team level on this route' : 'Recommended level'}: {rng(r)} <span class={`conf conf-${r.confidence}`}>{r.confidence === 'low' ? 'LOW confidence' : r.confidence}</span>{r.basis && <span class="mut"> · {r.basis}</span>}</span>)}
</div>}
