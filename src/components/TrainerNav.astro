---
import fights from '../data/fights.json';
const { f, compact = false } = Astro.props; const b = import.meta.env.BASE_URL;
const F = id => fights[id];
const tag = o => o.kind==='variant' ? 'one of (starter/choice variants)' : o.kind==='multi' ? 'multi battle (one fight)' : o.kind==='double' ? 'double battle (one fight)' : '';
const rows = [['← Previous', f.prev], ['Next →', f.next]];
---
<div class={compact ? 'tnav' : 'tnav top'}>
{rows.map(([label, opts]) => <div><b>{label}<a href="#order-note">†</a>:</b> {opts.length === 0 ? <span class="mut">{label.startsWith('Next') ? 'end of trainer list' : 'first trainer'}</span> :
  opts.map((o,i) => <>{i>0 && <span class="mut"> or </span>}{o.fights.map((id,j)=><>{j>0 && <span class="mut"> / </span>}<a href={`${b}trainer/${F(id).slug}/`}>{F(id).title}</a></>)}
  <span class="mut">{[F(o.fights[0]).area !== f.area ? `(${F(o.fights[0]).area}${F(o.fights[0]).split !== f.split ? ', ' + F(o.fights[0]).split + ' split' : ''})` : '', tag(o), o.optional ? 'optional' : ''].filter(Boolean).map(x=>' · '+x).join('')}</span></>)}</div>)}
{!compact && f.alts.length > 0 && <div><b>Alternative versions:</b> {f.alts.map((id,j)=><>{j>0 && ' · '}<a href={`${b}trainer/${F(id).slug}/`}>{F(id).title}</a></>)}</div>}
</div>
