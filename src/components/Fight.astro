---
import Trainer from './Trainer.astro'; import TrainerNav from './TrainerNav.astro';
import trainers from '../data/trainers.json'; import fights from '../data/fights.json';
const { f, link = true, nav = false } = Astro.props; const b = import.meta.env.BASE_URL;
const ms = f.members.map(id => trainers[id]);
---
{f.kind === 'single' ? <Trainer t={ms[0]} link={link} href={`${b}trainer/${f.slug}/`}>{f.alsoDouble != null && <p class="note">Can also be fought together as a double battle with <a href={`${b}trainer/${fights[f.alsoDouble].slug}/`}>{fights[f.alsoDouble].title}</a> (per Jack, not in docs)</p>}{nav && <TrainerNav f={f} compact />}</Trainer> :
<div class="card"><h3>{link ? <a href={`${b}trainer/${f.slug}/`}>{f.title}</a> : f.title} <span class="mut" style="font-weight:400;font-size:13px">· {f.area} · {f.split} split</span></h3>
<p class="mut" style="font-size:13px;margin:.2rem 0">{f.kind==='double' ? 'One double battle (two sheet entries merged by explicit override).' : 'One fight: both trainers battle you together.'} Each team is listed under its trainer (sheet names: {ms.map(m=>m.name).join(' / ')}).</p>
{ms.map(m => <Trainer t={m} sub />)}
{nav && <TrainerNav f={f} compact />}</div>}
